{
  "manifest_version": 3,
  "name": "TabGrab",
  "description": "Grab URLs from selected tabs through a toolbar panel or the native tab context menu.",
  "version": "1.2.0",
  "permissions": [
    "tabs",
    "contextMenus",
    "clipboardWrite",
    "offscreen",
    "storage"
  ],
  "background": {
    "service_worker": "background.js"
  },
  "action": {
    "default_title": "TabGrab",
    "default_popup": "popup.html",
    "default_icon": {
      "16": "icons/icon16.png",
      "32": "icons/icon32.png",
      "48": "icons/icon48.png",
      "128": "icons/icon128.png"
    }
  },
  "icons": {
    "16": "icons/icon16.png",
    "32": "icons/icon32.png",
    "48": "icons/icon48.png",
    "128": "icons/icon128.png"
  }
}
